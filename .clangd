# clangd 配置:D:\Luos 库工作区
# 库是"单头文件 + .inl 片段"结构,片段要靠聚合头 wiall.hpp 才有上文,
# 否则单独打开 english/create.inl 这类文件时 Window / std / SDL 全是未知符号。
# 因此这里统一强制包含宿主的聚合头,再由 Diagnostics 抑制由此产生的重复定义噪音。

CompileFlags:
  Add:
    - -std=c++23
    - -DNDEBUG
    - -finput-charset=UTF-8
    - -fexec-charset=UTF-8
    # 片段被聚合头包含一次、又被当作主文件解析一次,重复定义会触发错误上限,
    # 关掉上限保证解析不中断(否则后面的符号会解析不到)
    - -ferror-limit=0
    - -ID:/Luos
    - -ID:/MemorySea
    - -ID:/mingw64/include
    - -ID:/mingw64/include/c++/v1
    - -ID:/mingw64/glm
    - -ID:/mingw64/SDL3-3.4.8/x86_64-w64-mingw32/include
    - -ID:/mingw64/SDL3-3.4.8/x86_64-w64-mingw32/include/SDL3
    - -ID:/mingw64/inih-r62/inih-r62
    - -ID:/mingw64/simdjson-4.6.7/simdjson-4.6.7/include
    - -ID:/mingw64/simdjson-4.6.7/simdjson-4.6.7/src
    - -ID:/mingw64/spine-runtimes-4.3/spine-cpp/include
    - -ID:/mingw64/spine-runtimes-4.3/spine-sdl/src
    - -ID:/mingw64/stb-master/stb-master
    - -IC:/vulkan/Include
    - -include
    - D:/MemorySea/youklx/wiall.hpp

Diagnostics:
  Suppress:
    # 片段同时作为主文件被解析,类内声明会重复出现
    - redefinition
    - redefinition_different_kind
    # 类体内声明片段(available/function.inl 等)脱离类作用域后,成员类型要加限定名才认,
    # 这些报错没有信息量,统一静音;类型本身在聚合头里有,跳转与补全仍可用
    - unknown_typename_suggest
